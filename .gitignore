# Local runtime/environment artifacts.
# The harness may run with HOME set to the workspace, so XDG dirs, Forge state
# (which can contain real credentials) and Playwright/Chromium artifacts appear
# at the repository root. Never commit these.
.cache/
.config/
.local/
.npm/
node-compile-cache/
/tmp.*/
/ctx-*/
playwright-artifacts-*/
playwright_chromiumdev_profile-*/
org.chromium.Chromium.*/

# Ad-hoc terminal probes and their captured output (repository root only).
/tmp-pty-probe.py
/tmp-pty-probe.bin
/tmp-startup-raw.bin
/tmp-tty.log

# Local upstream checkout for reference only; not part of Forge sources.
/references/CometixCode/
/references/magpie/
