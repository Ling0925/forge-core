      "types": "./src/shared/harness-adaptation.ts",
      "import": "./dist/shared/harness-adaptation.js"
    },
    "./shared/ipc": {
      "types": "./src/shared/ipc.ts",
      "import": "./dist/shared/ipc.js"
    },
    "./shared/bridge": {
      "types": "./src/shared/bridge.ts",
      "import": "./dist/shared/bridge.js"
    },
    "./shared/project-context": {
      "types": "./src/shared/project-context.ts",
      "import": "./dist/shared/project-context.js"
    },
    "./shared/build-info": {
      "types": "./src/shared/build-info.ts",
      "import": "./dist/shared/build-info.js"
    },
    "./shared/schemas": {
      "types": "./src/shared/schemas.ts",
      "import": "./dist/shared/schemas.js"
    },
    "./shared/mcp": {
      "types": "./src/shared/mcp.ts",
      "import": "./dist/shared/mcp.js"
    },
    "./shared/checkpoints": {
      "types": "./src/shared/checkpoints.ts",
