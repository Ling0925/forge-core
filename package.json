{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "description": "Forge agent runtime, stores, tools, host transports and shared client contracts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json",
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./dist/core/index.js"
    },
    "./provider": {
      "types": "./src/provider/index.ts",
      "import": "./dist/provider/index.js"
    },
    "./store": {
      "types": "./src/store/index.ts",
      "import": "./dist/store/index.js"
    },
    "./superagent": {
      "types": "./src/superagent/index.ts",
      "import": "./dist/superagent/index.js"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./dist/tools/index.js"
    },
    "./context": {
      "types": "./src/context/index.ts",
      "import": "./dist/context/index.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./dist/mcp/index.js"
    },
    "./plugins": {
      "types": "./src/plugins/index.ts",
      "import": "./dist/plugins/index.js"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./dist/host/index.js"
