{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "description": "Forge agent runtime, stores, tools, host transports and shared client contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json",
    "./*": { "types": "./src/*.ts", "import": "./dist/*.js" }
  },
  "bin": { "forge-core": "dist/web/serve.js" },
  "files": ["dist", "src", "README.md", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=22.23.1 <23" },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node dist/web/serve.js",
    "test": "vitest run",
    "test:package": "node --test tests/package.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "openai": "^7.35.0",
    "ws": "8.22.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "3.25.2"
  },
  "optionalDependencies": {
    "agent-browser": "0.39.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "agent-browser-dev": "npm:agent-browser@0.39.2",
    "esbuild": "^0.25.3",
    "playwright": "^1.51.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
