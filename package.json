    },
    "./shared/runtime-host": {
      "types": "./src/shared/runtime-host.ts",
      "import": "./dist/shared/runtime-host.js"
    }
  },
  "bin": { "forge-core": "dist/web/serve.js" },
  "files": ["dist", "src", "README.md", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=22.23.1 <23" },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node dist/web/serve.js",
    "test": "vitest run",
    "test:package": "node --test tests/package.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "htmlparser2": "^12.0.0",
