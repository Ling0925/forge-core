{
  "name": "forge-desktop-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Original shared desktop and CLI agent harness",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "forge": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "desktop": "electron .",
    "cli": "node dist/cli.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "package": "pnpm build && electron-builder --linux --dir",
    "audit:react": "react-doctor .",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "ink": "6.6.0",
    "ky": "^1.8.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "playwright": "^1.51.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "string-width": "8.3.0",
    "ws": "8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.3",
    "react-doctor": "^0.9.18",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^3.1.2"
  },
  "build": {
    "appId": "org.forge.harness",
    "productName": "Forge",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!.build/**/*"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "executableName": "forge-desktop"
    }
  }
}
